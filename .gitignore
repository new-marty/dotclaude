# ~/.claude holds configuration and runtime state side by side.
# Ignore everything by default and allow the configuration files explicitly.
# This way, new runtime files that Claude Code creates never slip into
# the tracked set.

*

# --- Tracked configuration ---
!.gitignore
!README.md
!ADOPTIONS.md
!CLAUDE.md
# settings.json itself is per machine: Orca and other tools inject hooks into it,
# and a headless machine runs its own. Only the starting point is tracked.
!settings.example.json
!statusline.sh

!skills/
!scripts/
!output-styles/

!skills/**
!scripts/**
!output-styles/**

# Skills claude.ai syncs down per account, under a directory named by the account
# id. Runtime state, rewritten on every sync; another machine has its own copy.
skills/synced/
# Where Claude Code moves a skill it deletes or replaces. A trash can, per machine.
skills/.trash/

# Symlinks Orca creates per machine. Tracking them leaves broken links on
# machines without Orca.
skills/computer-use
skills/find-skills
skills/orca-cli
skills/orchestration

# --- Backstop ---
# Last line of defense against pulling in credentials when the allow list
# above grows later.
*-oauth-token
*.pem
*.key
.DS_Store

# Dependencies mermaid-term resolves locally. Reproducible from package.json
# and the lockfile.
scripts/mermaid-term/node_modules/
